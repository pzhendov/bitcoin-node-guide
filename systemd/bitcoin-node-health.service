[Unit]
Description=Bitcoin Core node health check and alert dispatcher
Wants=network-online.target
After=network-online.target chrony.service bitcoind.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu

EnvironmentFile=-/etc/bitcoin-node-health/telegram.env

RuntimeDirectory=bitcoin-node-health
RuntimeDirectoryMode=0700
StateDirectory=bitcoin-node-health
StateDirectoryMode=0700

ExecStart=/usr/local/bin/bitcoin-node-health-runner
SuccessExitStatus=1
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
